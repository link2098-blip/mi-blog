---
const today = new Date();
---

<footer>
	<div class="pixel-divider"></div>
	<p>&copy; {today.getFullYear()} Papá Gamer. Todos los derechos reservados.</p>
	<p class="tagline">Jugando la mejor partida de mi vida.</p>
</footer>

<style>
	footer {
		padding: 3em 1em 2em 1em;
		background: #0f172a; /* Mismo fondo de la página principal */
		color: #64748b;
		text-align: center;
		font-family: 'Inter', sans-serif;
		margin-top: 4em;
	}
	.pixel-divider {
		width: 100px;
		height: 4px;
		background: #38bdf8;
		margin: 0 auto 1.5em auto;
		border-radius: 2px;
	}
	.tagline {
		font-size: 0.85rem;
		margin-top: 0.5em;
		color: #475569;
	}
</style>