---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/mi-blog/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/mi-blog/">Inicio</HeaderLink>
			<HeaderLink href="/mi-blog/blog">Blog</HeaderLink>
			<HeaderLink href="/mi-blog/about">Sobre Mí</HeaderLink>
		</div>
	</nav>
</header>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

	header {
		margin: 0;
		padding: 0 1em;
		background: #1e293b; /* Fondo oscuro de la barra */
		border-bottom: 4px solid #38bdf8; /* Línea gruesa azul neón */
		box-shadow: 0 4px 0px rgba(0, 0, 0, 0.3); /* Sombra para dar profundidad */
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.2em 0;
		max-width: 960px;
		margin: 0 auto;
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		font-family: 'Press Start 2P', cursive;
	}
	h2 a {
		text-decoration: none;
		color: #f8fafc;
		text-shadow: 2px 2px 0px #0ea5e9; /* Efecto retro en el título del sitio */
	}
	h2 a:hover {
		color: #38bdf8;
	}
	.internal-links {
		display: flex;
		gap: 1.5em;
	}
	.internal-links a {
		color: #94a3b8;
		text-decoration: none;
		font-family: 'Press Start 2P', cursive;
		font-size: 0.7rem; /* Letra más pequeña para los links */
		transition: color 0.2s;
	}
	.internal-links a:hover,
	.internal-links a.active {
		color: #38bdf8;
	}
</style>
